<Window x:Class="DigUp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAI — Настройки" Width="660" Height="780" MinWidth="580" MinHeight="620" MaxHeight="960"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White">
  <Window.Resources>
    <!-- Base Button Style -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#353535" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#454545" />
          <Setter Property="BorderBrush" Value="#555555" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
          <Setter Property="BorderBrush" Value="#2B88D8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Primary Action Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0078D4" />
      <Setter Property="BorderBrush" Value="#2B88D8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1084D8" />
          <Setter Property="BorderBrush" Value="#429CE3" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#005A9E" />
          <Setter Property="BorderBrush" Value="#005A9E" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Danger Button (Clear Vectors) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#402020" />
      <Setter Property="BorderBrush" Value="#663030" />
      <Setter Property="Foreground" Value="#FFAAAA" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#5C2525" />
          <Setter Property="BorderBrush" Value="#8B3636" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#801818" />
          <Setter Property="BorderBrush" Value="#A02020" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Modern Dark ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#222222" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                    CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#1C4B72" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark ComboBox Toggle Button -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
      <Border x:Name="ButtonBorder" Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ButtonBorder" Property="Background" Value="#353535" />
          <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#555555" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Modern Dark ComboBox Style -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Template="{StaticResource ComboBoxToggleButtonTemplate}"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" />
              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="10,6,28,6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Border x:Name="DropDownBorder"
                        Background="#202020"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.5" Color="Black" />
                  </Border.Effect>
                  <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DDDDDD" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ListBox Style -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="#3E3E3E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Card Border -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Modern Dark ScrollBar Style -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="#444444" CornerRadius="4" Margin="2,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#666666" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#0078D4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="18">
    <!-- Bottom Action Bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button x:Name="BtnAbout" Content="О программе (About)…" DockPanel.Dock="Left" Click="OnAboutClick" Focusable="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnApply" Content="Применить" Width="105" Margin="0,0,10,0" Click="OnApply" ToolTip="Применить настройки к окну поиска не закрывая это окно" />
        <Button x:Name="BtnCancel" Content="Отмена" Width="95" Margin="0,0,10,0" Click="OnCancel" />
        <Button x:Name="BtnSave" Content="Сохранить" Width="110" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </DockPanel>

    <!-- Scrollable content area -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <!-- Header with Language Switcher and Version -->
        <DockPanel Margin="0,0,0,14">
          <TextBlock x:Name="TxtHeaderTitle" Text="Настройки WAI" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Language Toggle Switcher [ RU | EN ] -->
            <Border Background="#282828" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="2">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnLangRu" Content="RU" Width="36" Height="24" Padding="0" Margin="0,0,2,0"
                        FontSize="11" FontWeight="SemiBold" Click="OnLangRuClick" Focusable="False"
                        ToolTip="Русский язык интерфейса" />
                <Button x:Name="BtnLangEn" Content="EN" Width="36" Height="24" Padding="0"
                        FontSize="11" FontWeight="SemiBold" Click="OnLangEnClick" Focusable="False"
                        ToolTip="English interface language" />
              </StackPanel>
            </Border>
            <!-- Version badge -->
            <Border Background="#2E4A62" CornerRadius="4" Padding="8,4">
              <TextBlock x:Name="TextAppVersion" Text="v1.1.0 Windows" FontSize="11" Foreground="#80D8FF" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- Informational banner about initial indexing -->
        <Border x:Name="BannerInitialIndex" Background="#1C2E3D" BorderBrush="#256B9E" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
          <DockPanel>
            <TextBlock Text="💡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock x:Name="TxtBannerDesc" TextWrapping="Wrap" FontSize="12" Foreground="#D0E8FF"
                       Text="Первичная индексация может занять некоторое время. Вы можете свернуть или закрыть приложение — при повторном открытии процесс автоматически продолжится с того же места." />
          </DockPanel>
        </Border>

        <!-- Section 1: Folders to search -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtFoldersTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Папки для поиска" />
            <TextBlock x:Name="TxtFoldersDesc" Foreground="#888888" FontSize="12" Margin="0,0,0,8" Text="Файлы в этих папках индексируются для мгновенного семантического и текстового поиска." />
            <ListBox x:Name="Folders" Height="110" Margin="0,0,0,8" SelectionChanged="OnFoldersSelectionChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnAddFolder" Content="Добавить папку…" Margin="0,0,8,0" Click="OnAdd" />
              <Button x:Name="BtnRemoveFolder" Content="Удалить" Click="OnRemove" />
            </StackPanel>

            <!-- Folder & Embeddings Storage Stats -->
            <Border Background="#1A2733" BorderBrush="#256B9E" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="TxtStatsHeader" Text="📊 Статистика эмбеддингов:" FontWeight="SemiBold" FontSize="12" Foreground="#80D8FF" />
                  <TextBlock x:Name="TxtDbTotalSize" Text="" HorizontalAlignment="Right" Foreground="#888888" FontSize="11" />
                </DockPanel>
                <TextBlock x:Name="TxtFolderStats" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="12"
                           Text="Загрузка статистики…" />
              </StackPanel>
            </Border>

            <!-- Orphaned / Inactive Folders Vectors Cache -->
            <Border x:Name="CardOrphaned" Background="#221C14" BorderBrush="#8A631E" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="TxtOrphanedTitle" Text="💾 Сохраненный кэш удаленных папок" FontWeight="SemiBold" FontSize="12" Foreground="#FFD54F" />
                  <Button x:Name="BtnPurgeOrphaned" Content="🗑️ Очистить кэш" HorizontalAlignment="Right" Click="OnPurgeOrphaned" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" />
                </DockPanel>
                <TextBlock x:Name="TxtOrphanedInfo" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FFE082" FontSize="12"
                           Text="В базе сохранены векторы неактивных папок..." />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Section 2: Vector index management -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtVectorsTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Векторный индекс и эмбеддинги" />
            <TextBlock x:Name="TxtVectorsDesc" Foreground="#888888" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="Векторные эмбеддинги формируются локальной моделью и обеспечивают поиск по смыслу запроса." />
            <WrapPanel Margin="0,0,0,6">
              <Button x:Name="BtnClearFolderVectors" Content="Очистить векторы выбранной папки" Margin="0,0,8,6"
                      Click="OnClearFolderVectors" ToolTip="Очищает векторы только для папки, выделенной в списке выше" />
              <Button x:Name="BtnClearAllVectors" Content="Очистить весь векторный индекс" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6"
                      Click="OnClearAllVectors" ToolTip="Удаляет все векторы по всем папкам и ставит их в очередь на переиндексацию" />
            </WrapPanel>
            <TextBlock x:Name="TxtVectorsNote" Foreground="#777777" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Используйте очистку выбранной папки для частичного обновления или полную очистку при смене модели эмбеддингов." />
          </StackPanel>
        </Border>

        <!-- Section: Embedding Model Selector -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtModelTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Модель векторных эмбеддингов (Нейросеть поиска)" />
            <TextBlock x:Name="TxtModelDesc" Foreground="#888888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Выберите модель машинного обучения для семантического поиска. Поддерживается переключение между EmbeddingGemma 2, BGE-M3, Perplexity Embed v2 и Nomic v1.5 с сохранением поиска по всем типам файлов." />

            <TextBlock x:Name="TxtModelActiveLabel" Text="Активная модель эмбеддингов:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4" />
            <ComboBox x:Name="ComboEmbeddingModel" DisplayMemberPath="DisplayName" Margin="0,0,0,8" SelectionChanged="OnModelSelectionChanged" />

            <Border Background="#1A2826" BorderBrush="#257E70" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <StackPanel>
                <TextBlock x:Name="TxtModelStatusHeader" Text="🧠 Характеристики и статус модели:" FontWeight="SemiBold" FontSize="12" Foreground="#80FFE8" />
                <TextBlock x:Name="TxtModelStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="12"
                           Text="Загрузка каталога моделей…" />
                <TextBlock x:Name="TxtModelDetails" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="11" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="TxtModelNote" Foreground="#777777" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Для каждой модели создаётся отдельный изолированный индекс. Предыдущие индексы сохраняются и не удаляются при переключении." />
          </StackPanel>
        </Border>

        <!-- Section: Hardware Acceleration (CPU / GPU) -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtHwTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Аппаратное ускорение (CPU / GPU для эмбеддингов)" />
            <TextBlock x:Name="TxtHwDesc" Foreground="#888888" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Выбор устройства для локальной генерации векторных эмбеддингов (поиск по смыслу). Поддерживаются дискретные и встроенные видеокарты всех производителей и процессорные вычисления." />

            <TextBlock x:Name="TxtHwDeviceLabel" Text="Вычислительное устройство:" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4" />
            <ComboBox x:Name="ComboHardware" DisplayMemberPath="Title" Margin="0,0,0,8" />

            <Border Background="#1A2733" BorderBrush="#256B9E" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <StackPanel>
                <TextBlock x:Name="TxtHwStatusHeader" Text="🖥 Обнаруженное оборудование:" FontWeight="SemiBold" FontSize="12" Foreground="#80D8FF" />
                <TextBlock x:Name="TxtHardwareStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#E0E0E0" FontSize="12"
                           Text="Определение оборудования…" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="TxtHwNote" Foreground="#777777" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Поддерживаются дискретные NVIDIA (CUDA/Vulkan), AMD Radeon (Vulkan), Intel Arc (Vulkan), встроенные Intel Iris Xe/UHD и AMD Radeon APU. В случае сбоя GPU происходит безопасный откат на CPU." />
          </StackPanel>
        </Border>

        <!-- Section 3: Appearance and Translucency -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtAppearanceTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Внешний вид и прозрачность виджета поиска" />
            <TextBlock x:Name="TxtAppearanceDesc" Foreground="#888888" FontSize="12" Margin="0,0,0,8"
                       Text="Настройка полупрозрачности, размытия и темы для виджета поиска." />

            <DockPanel Margin="0,0,0,6">
              <TextBlock x:Name="TxtOpacityLabel" Text="Прозрачность виджета поиска:" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtOpacityValue" Text="100%" Foreground="#80D8FF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Slider x:Name="SliderOpacity" Minimum="50" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"
                    ValueChanged="OnOpacitySliderChanged" />

            <CheckBox x:Name="ChkWidgetBlur" Content="Эффект размытия фона под виджетом (Acrylic Blur)" Margin="0,0,0,8"
                      ToolTip="Включает размытие содержимого экрана позади окна поиска (матовое стекло)" />

            <TextBlock x:Name="TxtThemeLabel" Text="Тема оформления интерфейса:" Foreground="#BBBBBB" FontSize="12" Margin="0,4,0,4" />
            <ComboBox x:Name="ComboTheme" Margin="0,0,0,4" />
          </StackPanel>
        </Border>

        <!-- Section 4: Shortcut -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtHotkeyTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Горячая клавиша (быстрый вызов)" />
            <TextBox x:Name="Hotkey" Margin="0,0,0,6" ToolTip="Кликните сюда и нажмите клавишу Пробел с зажатыми Shift, Ctrl, Alt или Win. Например: Ctrl+Space." />
            <TextBlock x:Name="TxtHotkeyDesc" Foreground="#888888" FontSize="12" TextWrapping="Wrap"
                       Text="По умолчанию: Ctrl+Space. Избегайте Win+Space (системная смена языка) и Shift+Alt (переключение раскладки)." />
          </StackPanel>
        </Border>

        <!-- Section 5: Code search -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtCodeTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Text="Поиск по коду" />
            <CheckBox x:Name="Code" Content="Индексировать исходный код (запросы, начинающиеся с code:)" />
            <TextBlock x:Name="TxtCodeEditorLabel" Margin="0,6,0,4" Foreground="#BBBBBB" Text="Открывать код в редакторе:" />
            <ComboBox x:Name="Editor" Margin="0,0,0,4" />
          </StackPanel>
        </Border>

        <!-- Section 6: System & Updates -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtSystemTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Text="Система и обновления" />
            <CheckBox x:Name="Startup" Content="Запускать WAI при старте Windows" />
            <CheckBox x:Name="Updates" Content="Проверять обновления программы раз в день" />
            <TextBlock x:Name="TxtUpdateSourceLabel" Text="Источник пакетов обновлений (GitHub Releases или локальная папка):" Foreground="#BBBBBB" Margin="0,4,0,4" />
            <TextBox x:Name="UpdateSource" Margin="0,0,0,6" ToolTip="Оставьте пустым для обновлений с https://github.com/ex-ru/win_search/releases или укажите локальную папку." />
            <TextBlock x:Name="TxtSystemNote" Foreground="#777777" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="WAI работает per-user: не требует прав администратора, данные хранятся в %LocalAppData%\WAI." />

            <!-- Diagnostic Logs -->
            <Border Background="#1C2228" BorderBrush="#334455" BorderThickness="1" CornerRadius="6" Padding="10,8">
              <DockPanel>
                <Button x:Name="BtnOpenLogs" Content="📂 Открыть папку с логами" DockPanel.Dock="Left" Click="OnOpenLogs" Padding="12,6" Margin="0,0,12,0" />
                <TextBlock x:Name="TxtLogsDesc" Foreground="#A0B0C0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Диагностические логи WAI, GPU/Vulkan и процесса индексации" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
