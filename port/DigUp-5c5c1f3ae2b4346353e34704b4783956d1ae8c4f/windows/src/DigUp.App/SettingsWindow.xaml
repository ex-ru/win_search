<Window x:Class="DigUp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DigUp — Настройки" Width="660" Height="780" MinWidth="580" MinHeight="620" MaxHeight="960"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White">
  <Window.Resources>
    <!-- Base Button Style -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#353535" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#454545" />
          <Setter Property="BorderBrush" Value="#555555" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
          <Setter Property="BorderBrush" Value="#2B88D8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Primary Action Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0078D4" />
      <Setter Property="BorderBrush" Value="#2B88D8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1084D8" />
          <Setter Property="BorderBrush" Value="#429CE3" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#005A9E" />
          <Setter Property="BorderBrush" Value="#005A9E" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Danger Button (Clear Vectors) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#402020" />
      <Setter Property="BorderBrush" Value="#663030" />
      <Setter Property="Foreground" Value="#FFAAAA" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#5C2525" />
          <Setter Property="BorderBrush" Value="#8B3636" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#801818" />
          <Setter Property="BorderBrush" Value="#A02020" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DDDDDD" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ListBox Style -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderBrush" Value="#3E3E3E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Card Border -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#252525" />
      <Setter Property="BorderBrush" Value="#383838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="18">
    <!-- Bottom Action Bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button Content="О программе (About)…" DockPanel.Dock="Left" Click="OnAboutClick" Focusable="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" Width="100" Margin="0,0,10,0" Click="OnCancel" />
        <Button Content="Сохранить" Width="120" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </DockPanel>

    <!-- Scrollable content area -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <!-- Header -->
        <DockPanel Margin="0,0,0,14">
          <TextBlock Text="Настройки DigUp" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
          <Border Background="#2E4A62" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="v1.0.4 Windows" FontSize="11" Foreground="#80D8FF" FontWeight="SemiBold" />
          </Border>
        </DockPanel>

        <!-- Section 1: Folders to search -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Папки для поиска" />
            <TextBlock Foreground="#888888" FontSize="12" Margin="0,0,0,8" Text="Файлы в этих папках индексируются для мгновенного семантического и текстового поиска." />
            <ListBox x:Name="Folders" Height="110" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Добавить папку…" Margin="0,0,8,0" Click="OnAdd" />
              <Button Content="Удалить" Click="OnRemove" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Section 2: Vector index management -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Векторный индекс и эмбеддинги" />
            <TextBlock Foreground="#888888" FontSize="12" Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Text="Векторные эмбеддинги формируются локальной моделью EmbeddingGemma 2 и обеспечивают поиск по смыслу запроса." />
            <DockPanel>
              <Button Content="Очистить векторный индекс" Style="{StaticResource DangerButtonStyle}"
                      Click="OnClearVectors" ToolTip="Удаляет все векторы по выбранным папкам и ставит файлы в очередь на переиндексацию" />
              <TextBlock Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                         Text="Используйте при обновлении модели эмбеддингов или необходимости полного пересчета векторов." />
            </DockPanel>
          </StackPanel>
        </Border>

        <!-- Section 3: Shortcut -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Text="Горячая клавиша (быстрый вызов)" />
            <TextBox x:Name="Hotkey" Margin="0,0,0,6" ToolTip="Кликните сюда и нажмите клавишу Пробел с зажатыми Shift, Ctrl, Alt или Win. Например: Ctrl+Alt+Space." />
            <TextBlock Foreground="#888888" FontSize="12" TextWrapping="Wrap"
                       Text="Пример: Ctrl+Alt+Space. Win+Space занято Windows; избегайте Shift+Alt (Windows переключает раскладку клавиатуры)." />
          </StackPanel>
        </Border>

        <!-- Section 4: Code search -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Text="Поиск по коду" />
            <CheckBox x:Name="Code" Content="Индексировать исходный код (запросы, начинающиеся с code:)" />
            <TextBlock Margin="0,6,0,4" Foreground="#BBBBBB" Text="Открывать код в редакторе:" />
            <ComboBox x:Name="Editor" Margin="0,0,0,4" />
          </StackPanel>
        </Border>

        <!-- Section 5: Overlay appearance -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Text="Внешний вид окна поиска" />
            <CheckBox x:Name="Blur" Content="Размывать фон за окном поиска (Windows Acrylic effect)" />
            <DockPanel Margin="0,4,0,2">
              <TextBlock Text="Затемнение экрана:" Foreground="#BBBBBB" VerticalAlignment="Center" />
              <TextBlock x:Name="DimValueLabel" Text="45%" Foreground="#80D8FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Slider x:Name="Dim" Minimum="0" Maximum="80" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <!-- Section 6: System & Updates -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Text="Система и обновления" />
            <CheckBox x:Name="Startup" Content="Запускать DigUp при старте Windows" />
            <CheckBox x:Name="Updates" Content="Проверять обновления программы раз в день" />
            <TextBlock Text="Локальный источник пакетов обновлений (releases.win.json):" Foreground="#BBBBBB" Margin="0,4,0,4" />
            <TextBox x:Name="UpdateSource" ToolTip="Выберите папку dist\releases или оставьте пустым для онлайн-проверки." />
            <TextBlock Foreground="#777777" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="DigUp работает per-user: не требует прав администратора, данные хранятся в %LocalAppData%\DigUp." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
