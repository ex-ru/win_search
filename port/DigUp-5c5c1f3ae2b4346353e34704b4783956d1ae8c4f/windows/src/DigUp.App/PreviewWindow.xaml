<Window x:Class="DigUp.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Look" Width="980" Height="720" MinWidth="580" MinHeight="420"
        WindowStyle="None" Background="#242424" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#383838" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#484848" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Resources>
  <Border Background="#242424" CornerRadius="12" Padding="18"
          BorderBrush="#444444" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock x:Name="Title" FontSize="17" FontWeight="SemiBold" Foreground="White"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" />
        <TextBlock x:Name="Kind" FontSize="13" Foreground="#AAAAAA" Margin="0,3,0,0" />
      </StackPanel>
      <!-- Pictures and video fit the space (no scrolling); words scroll. -->
      <Grid Grid.Row="1">
        <Image x:Name="Picture" Stretch="Uniform" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <MediaElement x:Name="Player" Stretch="Uniform" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      LoadedBehavior="Manual" UnloadedBehavior="Close" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" x:Name="WordsScroll"
                    Visibility="Collapsed">
        <TextBox x:Name="Words" IsReadOnly="True"
                 Background="Transparent" Foreground="#DDDDDD" FontSize="14"
                 BorderThickness="0" TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"
                  x:Name="Transport" Visibility="Collapsed">
        <Button x:Name="PlayPause" Content="Pause" Width="80" Margin="0,0,8,0" Click="OnPlayPause" Focusable="False" />
        <TextBlock x:Name="Time" Foreground="#AAAAAA" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Открыть" Width="100" Margin="0,0,8,0" Click="OnOpen" Focusable="False" />
        <Button Content="Закрыть" Width="100" Margin="0,0,16,0" Click="OnClose" Focusable="False" />
        <TextBlock Foreground="#888888" VerticalAlignment="Center"
                   Text="Пробел / Esc: закрыть · ↑ / ↓: след. документ · Enter: открыть" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
