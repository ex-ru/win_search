<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>wai-embed</AssemblyName>
    <RootNamespace>WAI.Embed</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Prepared PNGs are decoded here (ships in the app folder, no install). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>
</Project>
