<Window x:Class="WAI.App.Onboarding"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAI setup" Width="540" Height="450"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" MinWidth="420" MinHeight="360">
  <DockPanel Margin="20">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock x:Name="Step" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="Back" Width="100" Margin="0,0,8,0" Click="OnBack" />
      <Button x:Name="Next" MinWidth="120" Padding="10,5" IsDefault="True" Click="OnNext" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <StackPanel x:Name="P1">
        <TextBlock x:Name="FoldersIntro" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ListBox x:Name="Folders" Height="150" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AddFolder" MinWidth="110" Padding="8,5" Margin="0,0,8,0" Click="OnAdd" />
          <Button x:Name="RemoveFolder" MinWidth="90" Padding="8,5" Click="OnRemove" />
        </StackPanel>
        <TextBlock x:Name="Estimate" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel x:Name="P3" Visibility="Collapsed">
        <TextBlock x:Name="DownloadIntro" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ProgressBar x:Name="Bar" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,8" />
        <TextBlock x:Name="DlStatus" Foreground="Gray" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel x:Name="P4" Visibility="Collapsed">
        <TextBlock x:Name="ReadyIntro" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="ReadyShortcut" TextWrapping="Wrap" Foreground="Gray" />
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
