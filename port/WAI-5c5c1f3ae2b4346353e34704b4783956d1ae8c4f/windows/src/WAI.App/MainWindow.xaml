<Window x:Class="WAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAI — Windows AI Search" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="720" MinWidth="580" MaxWidth="1400" SizeToContent="Height" MinHeight="160" MaxHeight="860"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" ShowActivated="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <Window.Resources>
    <!-- Base Button Style -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#353535" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#484848" />
          <Setter Property="BorderBrush" Value="#555555" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
          <Setter Property="BorderBrush" Value="#2B88D8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Window Header Button Style (Matches PreviewWindow) -->
    <Style x:Key="WindowHeaderButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#383838" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#484848" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Close Button Style (Red on hover) -->
    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowHeaderButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#9E1E12" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Filter Chip Style -->
    <Style x:Key="FilterChipStyle" TargetType="Button">
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="#BBBBBB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3E3E3E" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChipBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipBorder" Property="Background" Value="#383838" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="Tag" Value="Active">
                <Setter TargetName="ChipBorder" Property="Background" Value="#0078D4" />
                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#2B88D8" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern Dark ScrollBar Style -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="#444444" CornerRadius="3" Margin="2,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#666666" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#0078D4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Floating standalone widget card with drop shadow -->
    <Border x:Name="Root" Margin="16" Background="#242424" CornerRadius="14"
            BorderBrush="#444444" BorderThickness="1" Padding="14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.75" Color="Black" />
      </Border.Effect>
      <StackPanel>
        <!-- Widget TitleBar & Mascot Header (Draggable) -->
        <Grid Margin="2,0,2,8" MouseLeftButtonDown="OnHeaderMouseDown" Background="Transparent" Cursor="SizeAll">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Mascot & App Logo -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="MascotBadge" Background="#1C384E" BorderBrush="#256B9E" BorderThickness="1" CornerRadius="10" Padding="6,2" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🐾" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                <TextBlock x:Name="MascotText" Text="WAI" FontSize="12" FontWeight="Bold" Foreground="#80D8FF" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="MascotSubtitle" Text="Windows AI Search — быстрый поиск по смыслу" Foreground="#777777" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>

        <!-- Window Buttons (Pin, Minimize, Close to tray) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
          <Button x:Name="BtnPin" Content="📌" Width="32" Height="26" FontSize="11" Margin="0,0,4,0"
                  Click="OnPinToggle" Focusable="False" ToolTip="Закрепить поверх всех окон"
                  Style="{StaticResource WindowHeaderButtonStyle}" />
          <Button x:Name="BtnMin" Content="—" Width="36" Height="26" FontSize="11" Margin="0,0,4,0"
                  Click="OnWidgetMinimize" Focusable="False" ToolTip="Свернуть"
                  Style="{StaticResource WindowHeaderButtonStyle}" />
          <Button x:Name="BtnClose" Content="✕" Width="36" Height="26" FontSize="11"
                  Click="OnWidgetClose" Focusable="False" ToolTip="Свернуть в трей (Esc)"
                  Style="{StaticResource WindowCloseButtonStyle}" />
        </StackPanel>
      </Grid>

      <!-- Search input with clear button -->
      <Grid Margin="0,0,0,10">
        <TextBox x:Name="Query" FontSize="18" Padding="12,9,42,9" Background="#333333" Foreground="White"
                 CaretBrush="White" BorderThickness="0"
                 ToolTip="Опишите, что ищете. code: для поиска кода. Enter — открыть, Esc — скрыть." />
        <Button x:Name="ClearButton" Content="✕" Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                Foreground="#AAAAAA" Background="#444444" BorderThickness="0"
                FontSize="11" FontWeight="Normal" Cursor="Hand" Focusable="False"
                Visibility="Collapsed" Click="OnClearQuery"
                ToolTip="Очистить строку поиска">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="Background" Value="#5A5A5A" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BtnBorder" Property="Background" Value="#707070" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>

      <!-- Type filter bar -->
      <WrapPanel x:Name="FilterBar" Margin="0,0,0,8">
        <Button x:Name="FilterAll" Content="Все" Style="{StaticResource FilterChipStyle}" Tag="Active" Click="OnFilterClick" />
        <Button x:Name="FilterPdf" Content="📄 PDF" Style="{StaticResource FilterChipStyle}" Click="OnFilterClick" />
        <Button x:Name="FilterImg" Content="🖼️ Картинки" Style="{StaticResource FilterChipStyle}" Click="OnFilterClick" />
        <Button x:Name="FilterDoc" Content="📝 Текст / Док" Style="{StaticResource FilterChipStyle}" Click="OnFilterClick" />
        <Button x:Name="FilterCode" Content="💻 Код" Style="{StaticResource FilterChipStyle}" Click="OnFilterClick" />
        <Button x:Name="FilterMedia" Content="🎬 Медиа" Style="{StaticResource FilterChipStyle}" Click="OnFilterClick" />
      </WrapPanel>

      <!-- Results list -->
      <ListBox x:Name="Results" FontSize="14" MinHeight="40" MaxHeight="420" Background="Transparent"
               BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!-- File Type & Relevance Match Accuracy Badge -->
              <StackPanel Grid.Column="0" Margin="0,1,10,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Border CornerRadius="5" Padding="7,2"
                        Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1">
                  <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeForeground}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="3" Padding="4,1" Margin="0,3,0,0" HorizontalAlignment="Center"
                        Background="{Binding RelevanceBackground}" ToolTip="{Binding RelevanceTooltip}">
                  <TextBlock Text="{Binding RelevancePercent}" FontSize="9" FontWeight="SemiBold"
                             Foreground="{Binding RelevanceForeground}" HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" Foreground="{DynamicResource ResultTitleBrush}" />
                <TextBlock Foreground="{DynamicResource ResultDetailBrush}" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#0078D4" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>

      <!-- Preview & Action card -->
      <Border x:Name="PreviewBox" Margin="0,8,0,0" Background="{DynamicResource CardBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="PreviewImageBorder" Grid.Column="0" Background="#202020" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
            <Image x:Name="PreviewImage" MaxHeight="170" Stretch="Uniform" Cursor="Hand" MouseDown="OnPreviewImageClick"
                   ToolTip="Дважды кликните для полноэкранного предпросмотра" />
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" Foreground="{DynamicResource ResultTitleBrush}" TextWrapping="Wrap" FontSize="14" />
            <TextBlock x:Name="PreviewKind" Foreground="{DynamicResource ResultDetailBrush}" Margin="0,2,0,6" FontSize="12" />
            <TextBlock x:Name="PreviewText" Foreground="{DynamicResource ResultBodyBrush}" TextWrapping="Wrap" MaxHeight="100"
                       TextTrimming="CharacterEllipsis" FontSize="13" />
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="BtnQuickLook" Content="👁️ Quick Look" Padding="10,5" Margin="0,0,6,4" Click="OnQuickLookButton" Focusable="False" />
              <Button x:Name="BtnOpen" Content="Открыть" Padding="10,5" Margin="0,0,6,4" Click="OnOpenButton" Focusable="False" />
              <Button x:Name="BtnInExplorer" Content="В проводнике" Padding="10,5" Margin="0,0,6,4" Click="OnShowButton" Focusable="False" />
              <Button x:Name="BtnOpenWith" Content="Выбрать программу…" Padding="10,5" Margin="0,0,6,4" Click="OnOpenWithButton" Focusable="False" ToolTip="Открыть в выбранном приложении" />
              <Button x:Name="BtnCopyPath" Content="Копировать путь" Padding="10,5" Margin="0,0,6,4" Click="OnCopyButton" Focusable="False" ToolTip="Скопировать полный путь к файлу в буфер обмена" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Footer status & Keyboard Badges -->
      <Grid Margin="2,10,2,2">
        <TextBlock x:Name="Status" Foreground="{DynamicResource ResultDetailBrush}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" Text="starting…" />

        <!-- Keycap Badges -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource KeycapBackgroundBrush}" BorderBrush="{DynamicResource KeycapBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
            <TextBlock Text="Ctrl+клик" FontSize="10" Foreground="{DynamicResource KeycapForegroundBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="мультивыбор · " Foreground="{DynamicResource ResultDetailBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

          <Border Background="{DynamicResource KeycapBackgroundBrush}" BorderBrush="{DynamicResource KeycapBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
            <TextBlock Text="Пробел" FontSize="10" Foreground="{DynamicResource KeycapForegroundBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="предпросмотр · " Foreground="{DynamicResource ResultDetailBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

          <Border Background="{DynamicResource KeycapBackgroundBrush}" BorderBrush="{DynamicResource KeycapBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
            <TextBlock Text="↵ Enter" FontSize="10" Foreground="{DynamicResource KeycapForegroundBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="открыть · " Foreground="{DynamicResource ResultDetailBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />

          <Border Background="{DynamicResource KeycapBackgroundBrush}" BorderBrush="{DynamicResource KeycapBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
            <TextBlock Text="Esc" FontSize="10" Foreground="{DynamicResource KeycapForegroundBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="закрыть" Foreground="{DynamicResource ResultDetailBrush}" FontSize="11" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>

    <!-- Invisible Left/Right horizontal resize thumb grips -->
    <Thumb x:Name="ResizeGripLeft" HorizontalAlignment="Left" Width="14" Cursor="SizeWE"
           DragDelta="OnResizeLeftDelta" Opacity="0" />
    <Thumb x:Name="ResizeGripRight" HorizontalAlignment="Right" Width="14" Cursor="SizeWE"
           DragDelta="OnResizeRightDelta" Opacity="0" />
  </Grid>
</Window>
