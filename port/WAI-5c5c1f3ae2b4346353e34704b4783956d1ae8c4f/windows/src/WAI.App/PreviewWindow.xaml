<Window x:Class="WAI.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAI Quick Look" Width="980" Height="720" MinWidth="600" MinHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#383838" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#484848" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#9E1E12" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="Foreground" Value="#E0E0E0" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="#444444" CornerRadius="3" Margin="2,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#666666" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#0078D4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#202020" CornerRadius="12" Padding="14"
          BorderBrush="#444444" BorderThickness="1"
          MouseLeftButtonDown="OnWindowMouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.75" Color="Black" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Window Title Bar with Menu and Window Controls -->
      <Grid Grid.Row="0" Margin="2,0,2,8" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Menu "Файл" -->
        <Menu Grid.Column="0" Background="Transparent" Foreground="White" VerticalAlignment="Center">
          <MenuItem Header="Файл" Foreground="White" Background="Transparent" FontSize="13" Padding="8,4">
            <MenuItem Header="Открыть" InputGestureText="Enter" Click="OnOpen" />
            <MenuItem Header="Открыть в проводнике" InputGestureText="Ctrl+E" Click="OnOpenInExplorer" />
            <MenuItem Header="Сохранить как…" InputGestureText="Ctrl+S" Click="OnSaveAs" />
            <MenuItem Header="Копировать путь" InputGestureText="Ctrl+C" Click="OnCopyPath" />
            <Separator Background="#444444" />
            <MenuItem Header="Зафиксировать это окно" x:Name="MenuPin" Click="OnPinToggle" />
            <Separator Background="#444444" />
            <MenuItem Header="Закрыть" InputGestureText="Esc" Click="OnClose" />
          </MenuItem>
        </Menu>

        <TextBlock Grid.Column="1" x:Name="HeaderTitle" Foreground="#888888" FontSize="12"
                   VerticalAlignment="Center" Margin="10,0,10,0" TextTrimming="CharacterEllipsis" />

        <!-- Window Buttons: Minimize, Maximize, Close -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnPin" Content="📌" Width="32" Height="26" Padding="0" Margin="0,0,4,0"
                  FontSize="11" Click="OnPinToggle" Focusable="False" ToolTip="Зафиксировать окно (не переключать при навигации поиска)" Opacity="0.6" />
          <Button x:Name="BtnMinimize" Content="—" Width="36" Height="26" Padding="0" Margin="0,0,4,0"
                  FontSize="11" Click="OnMinimize" Focusable="False" ToolTip="Свернуть окно" />
          <Button x:Name="BtnMaximize" Content="□" Width="36" Height="26" Padding="0" Margin="0,0,4,0"
                  FontSize="11" Click="OnMaximize" Focusable="False" ToolTip="Развернуть / восстановить" />
          <Button x:Name="BtnClose" Content="✕" Width="36" Height="26" Padding="0"
                  FontSize="11" Click="OnClose" Focusable="False" ToolTip="Закрыть предпросмотр (Esc)"
                  Style="{StaticResource CloseButtonStyle}" />
        </StackPanel>
      </Grid>

      <!-- File info header -->
      <StackPanel Grid.Row="1" Margin="4,0,4,10">
        <TextBlock x:Name="DocTitle" FontSize="16" FontWeight="SemiBold" Foreground="White"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" />
        <TextBlock x:Name="Kind" FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Pictures and video fit the space; words scroll -->
      <Grid Grid.Row="2">
        <Image x:Name="Picture" Stretch="Uniform" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <MediaElement x:Name="Player" Stretch="Uniform" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      LoadedBehavior="Manual" UnloadedBehavior="Close" />

        <!-- Floating PDF Page Navigation Overlay -->
        <Border x:Name="PdfNav" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#E6262626" BorderBrush="#555555" BorderThickness="1"
                CornerRadius="16" Padding="8,4" Margin="0,0,0,14">
          <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black" />
          </Border.Effect>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnPdfPrev" Content="◀" Width="30" Height="24" Padding="0" Margin="0,0,6,0"
                    Click="OnPdfPrevPage" ToolTip="Предыдущая страница (PageUp / Колесо вверх)" Focusable="False" />
            <TextBlock x:Name="PdfPageInfo" Text="Стр. 1 из 1" Foreground="White" FontSize="12"
                       VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold" />
            <Button x:Name="BtnPdfNext" Content="▶" Width="30" Height="24" Padding="0" Margin="6,0,0,0"
                    Click="OnPdfNextPage" ToolTip="Следующая страница (PageDown / Колесо вниз)" Focusable="False" />
          </StackPanel>
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" x:Name="WordsScroll"
                    Visibility="Collapsed">
        <TextBox x:Name="Words" IsReadOnly="True"
                 Background="Transparent" Foreground="#DDDDDD" FontSize="14"
                 BorderThickness="0" TextWrapping="Wrap" />
      </ScrollViewer>

      <!-- Transport for media -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,10,4,0"
                  x:Name="Transport" Visibility="Collapsed">
        <Button x:Name="PlayPause" Content="Pause" Width="80" Margin="0,0,8,0" Click="OnPlayPause" Focusable="False" />
        <TextBlock x:Name="Time" Foreground="#AAAAAA" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Action buttons & hint -->
      <Grid Grid.Row="4" Margin="4,12,4,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Content="Открыть" Width="95" Margin="0,0,8,0" Click="OnOpen" Focusable="False" />
          <Button Content="В проводнике" Width="115" Margin="0,0,8,0" Click="OnOpenInExplorer" Focusable="False" ToolTip="Показать файл в проводнике с выделением" />
          <Button Content="Сохранить как…" Width="125" Margin="0,0,8,0" Click="OnSaveAs" Focusable="False" ToolTip="Сохранить копию файла" />
          <Button Content="Закрыть" Width="90" Click="OnClose" Focusable="False" />
        </StackPanel>

        <!-- PDF Page Navigation in Action Bar -->
        <Border Grid.Column="1" x:Name="PdfToolbar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#2C2C2C" BorderBrush="#0078D4" BorderThickness="1"
                CornerRadius="8" Padding="8,3" Margin="8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnPdfPrevBar" Content="◀" Width="28" Height="24" Padding="0" Margin="0,0,6,0"
                    Click="OnPdfPrevPage" ToolTip="Предыдущая страница (PageUp / Колесо вверх)" Focusable="False" />
            <TextBlock x:Name="PdfPageInfoBar" Text="Стр. 1 из 1" Foreground="#80D8FF" FontSize="12"
                       VerticalAlignment="Center" Margin="6,0" FontWeight="SemiBold" />
            <Button x:Name="BtnPdfNextBar" Content="▶" Width="28" Height="24" Padding="0" Margin="6,0,0,0"
                    Click="OnPdfNextPage" ToolTip="Следующая страница (PageDown / Колесо вниз)" Focusable="False" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Column="2" Foreground="#777777" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="Пробел / Esc: закрыть · ↑ / ↓: след. документ · Enter: открыть" />
      </Grid>
    </Grid>
  </Border>
</Window>
