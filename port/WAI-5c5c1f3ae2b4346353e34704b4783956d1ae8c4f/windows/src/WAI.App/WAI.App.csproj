<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WAIApp</AssemblyName>
    <RootNamespace>WAI.App</RootNamespace>
    <StartupObject>WAI.App.App</StartupObject>
    <ApplicationIcon>Assets\WAI.ico</ApplicationIcon>
    <RollForward>LatestMajor</RollForward>
    <!-- AssemblyName differs from the wai CLI on purpose: Windows disks are
         case-insensitive, so WAI.dll would overwrite wai.dll in one folder.
         Product name shown to users stays "WAI". -->
    <!-- One folder, no admin: everything lives next to the exe + %LocalAppData%\WAI. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WAI.Core\WAI.Core.csproj" />
    <!-- Thumbnails (ships in the app folder, no install). -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <!-- Embedded for windows + tray (pack:// URI); the exe icon comes from ApplicationIcon above. -->
    <Resource Include="Assets\WAI.ico" />
  </ItemGroup>
</Project>
