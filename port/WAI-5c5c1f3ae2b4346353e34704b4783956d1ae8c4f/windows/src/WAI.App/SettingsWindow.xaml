<Window x:Class="WAI.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAI — Настройки" Width="660" Height="680" MinWidth="420" MinHeight="400" MaxHeight="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
  <Window.Resources>
    <!-- Default Brushes (Dark theme defaults) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="#80D8FF" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ItemSelectedBackgroundBrush" Color="#1C4B72" />
    <SolidColorBrush x:Key="ItemSelectedForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#353535" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#454545" />
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#555555" />

    <SolidColorBrush x:Key="DangerButtonBackgroundBrush" Color="#402020" />
    <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#663030" />
    <SolidColorBrush x:Key="DangerButtonForegroundBrush" Color="#FFAAAA" />

    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="#CCCCCC" />

    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#1C2E3D" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#256B9E" />
    <SolidColorBrush x:Key="BannerForegroundBrush" Color="#D0E8FF" />

    <SolidColorBrush x:Key="StatsBoxBackgroundBrush" Color="#1A2733" />
    <SolidColorBrush x:Key="StatsBoxBorderBrush" Color="#256B9E" />
    <SolidColorBrush x:Key="StatsBoxHeaderBrush" Color="#80D8FF" />
    <SolidColorBrush x:Key="StatsBoxTextBrush" Color="#E0E0E0" />

    <SolidColorBrush x:Key="OrphanedBoxBackgroundBrush" Color="#221C14" />
    <SolidColorBrush x:Key="OrphanedBoxBorderBrush" Color="#8A631E" />
    <SolidColorBrush x:Key="OrphanedBoxHeaderBrush" Color="#FFD54F" />
    <SolidColorBrush x:Key="OrphanedBoxTextBrush" Color="#FFE082" />

    <SolidColorBrush x:Key="ModelBoxBackgroundBrush" Color="#1A2826" />
    <SolidColorBrush x:Key="ModelBoxBorderBrush" Color="#257E70" />
    <SolidColorBrush x:Key="ModelBoxHeaderBrush" Color="#80FFE8" />

    <SolidColorBrush x:Key="HwBoxBackgroundBrush" Color="#1A2733" />
    <SolidColorBrush x:Key="HwBoxBorderBrush" Color="#256B9E" />
    <SolidColorBrush x:Key="HwBoxHeaderBrush" Color="#80D8FF" />

    <SolidColorBrush x:Key="LogsBoxBackgroundBrush" Color="#1C2228" />
    <SolidColorBrush x:Key="LogsBoxBorderBrush" Color="#334455" />
    <SolidColorBrush x:Key="LogsBoxTextBrush" Color="#A0B0C0" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#444444" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#666666" />
    <SolidColorBrush x:Key="ExpanderHeaderHoverBrush" Color="#303030" />

    <!-- Base Button Style -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#0078D4" />
          <Setter Property="BorderBrush" Value="#2B88D8" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Primary Action Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0078D4" />
      <Setter Property="BorderBrush" Value="#2B88D8" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1084D8" />
          <Setter Property="BorderBrush" Value="#429CE3" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#005A9E" />
          <Setter Property="BorderBrush" Value="#005A9E" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Danger Button (Clear Vectors) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerButtonBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerButtonForegroundBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DC2626" />
          <Setter Property="BorderBrush" Value="#B91C1C" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#991B1B" />
          <Setter Property="BorderBrush" Value="#7F1D1D" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Modern ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                    CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemSelectedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ItemSelectedForegroundBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern ComboBox Toggle Button -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
      <Border x:Name="ButtonBorder" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
          </Grid.ColumnDefinitions>
          <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}" />
          <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0078D4" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Modern ComboBox Style -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Template="{StaticResource ComboBoxToggleButtonTemplate}"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" />
              <ContentPresenter x:Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="10,6,28,6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Slide">
                <Border x:Name="DropDownBorder"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        BorderBrush="{DynamicResource PopupBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                  </Border.Effect>
                  <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox Style -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ListBox Style -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Card Border -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Unified Modern Expander Style -->
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <Border Background="{TemplateBinding Background}" BorderThickness="0">
              <DockPanel>
                <ToggleButton x:Name="HeaderSite"
                              DockPanel.Dock="Top"
                              Focusable="False"
                              Cursor="Hand"
                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border x:Name="HeaderBorder"
                              Background="{DynamicResource CardBackgroundBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="14,10">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                          </StackPanel>
                          <Path x:Name="Chevron" Grid.Column="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="10" Height="6" Stretch="Uniform"
                                Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                                Data="M 1 1 L 5 5 L 9 1"
                                RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                              <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                          </Path>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ExpanderHeaderHoverBrush}" />
                          <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                             FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </ToggleButton>
                <ContentPresenter x:Name="ExpandSite"
                                  DockPanel.Dock="Bottom"
                                  Focusable="False"
                                  Visibility="Collapsed" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern ScrollBar Style -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="2,0" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#0078D4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ModernScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="18">
    <!-- Bottom Action Bar -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button x:Name="BtnAbout" Content="О программе (About)…" DockPanel.Dock="Left" Click="OnAboutClick" Focusable="False" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnApply" Content="Применить" Width="105" Margin="0,0,10,0" Click="OnApply" ToolTip="Применить настройки к окну поиска не закрывая это окно" />
        <Button x:Name="BtnCancel" Content="Отмена" Width="95" Margin="0,0,10,0" Click="OnCancel" />
        <Button x:Name="BtnSave" Content="Сохранить" Width="110" IsDefault="True" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </DockPanel>

    <!-- Scrollable content area -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <!-- Header with Language Switcher and Version -->
        <DockPanel Margin="0,0,0,14">
          <TextBlock x:Name="TxtHeaderTitle" Text="Настройки WAI" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Language Toggle Switcher [ RU | EN ] -->
            <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" Padding="2">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnLangRu" Content="RU" Width="36" Height="24" Padding="0" Margin="0,0,2,0"
                        FontSize="11" FontWeight="SemiBold" Click="OnLangRuClick" Focusable="False"
                        ToolTip="Русский язык интерфейса" />
                <Button x:Name="BtnLangEn" Content="EN" Width="36" Height="24" Padding="0"
                        FontSize="11" FontWeight="SemiBold" Click="OnLangEnClick" Focusable="False"
                        ToolTip="English interface language" />
              </StackPanel>
            </Border>
            <!-- Version badge in unified styling matching language toggle -->
            <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Height="28" Padding="10,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🏷️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock x:Name="TextAppVersion" Text="v1.2.1 Windows" FontSize="11" Foreground="{DynamicResource BadgeForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>

        <!-- Informational banner about initial indexing -->
        <Border x:Name="BannerInitialIndex" Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource BannerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
          <DockPanel>
            <TextBlock Text="💡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
            <TextBlock x:Name="TxtBannerDesc" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource BannerForegroundBrush}"
                       Text="Первичная индексация может занять некоторое время. Вы можете свернуть или закрыть приложение — при повторном открытии процесс автоматически продолжится с того же места." />
          </DockPanel>
        </Border>

        <!-- Section 1: Folders to search -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtFoldersTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Папки для поиска" />
            <TextBlock x:Name="TxtFoldersDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" Text="Файлы в этих папках индексируются для мгновенного семантического и текстового поиска." />
            <ListBox x:Name="Folders" Height="110" Margin="0,0,0,8" SelectionChanged="OnFoldersSelectionChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="BtnAddFolder" Content="Добавить папку…" Margin="0,0,8,0" Click="OnAdd" />
              <Button x:Name="BtnRemoveFolder" Content="Удалить" Click="OnRemove" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Section 4: Shortcut -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtHotkeyTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Горячая клавиша (быстрый вызов)" />
            <TextBox x:Name="Hotkey" Margin="0,0,0,6" ToolTip="Кликните сюда и нажмите клавишу Пробел с зажатыми Shift, Ctrl, Alt или Win. Например: Ctrl+Space." />
            <TextBlock x:Name="TxtHotkeyDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="По умолчанию: Ctrl+Space. Избегайте Win+Space (системная смена языка) и Shift+Alt (переключение раскладки)." />
          </StackPanel>
        </Border>

        <!-- Section Theme & Startup -->
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock x:Name="TxtThemeLabel" Text="Тема оформления интерфейса:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,4" />
            <ComboBox x:Name="ComboTheme" Margin="0,0,0,8" />
            <CheckBox x:Name="Startup" Content="Запускать WAI при старте Windows" />
          </StackPanel>
        </Border>

        <!-- Section: Advanced Panel Expander -->
        <Expander x:Name="AdvancedPanel" Header="Дополнительно" IsExpanded="False" Margin="0,4,0,8">
          <StackPanel Margin="0,12,0,0">
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <!-- Folder & Embeddings Storage Stats -->
                <Border Background="{DynamicResource StatsBoxBackgroundBrush}" BorderBrush="{DynamicResource StatsBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock x:Name="TxtStatsHeader" Text="📊 Статистика эмбеддингов:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource StatsBoxHeaderBrush}" />
                      <TextBlock x:Name="TxtDbTotalSize" Text="" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                    </DockPanel>
                    <TextBlock x:Name="TxtFolderStats" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource StatsBoxTextBrush}" FontSize="12"
                               Text="Загрузка статистики…" />
                  </StackPanel>
                </Border>

                <!-- Orphaned / Inactive Folders Vectors Cache -->
                <Border x:Name="CardOrphaned" Background="{DynamicResource OrphanedBoxBackgroundBrush}" BorderBrush="{DynamicResource OrphanedBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock x:Name="TxtOrphanedTitle" Text="💾 Сохраненный кэш удаленных папок" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource OrphanedBoxHeaderBrush}" />
                      <Button x:Name="BtnPurgeOrphaned" Content="🗑️ Очистить кэш" HorizontalAlignment="Right" Click="OnPurgeOrphaned" Style="{StaticResource DangerButtonStyle}" Padding="8,4" FontSize="11" />
                    </DockPanel>
                    <TextBlock x:Name="TxtOrphanedInfo" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource OrphanedBoxTextBrush}" FontSize="12"
                               Text="В базе сохранены векторы неактивных папок..." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- Section 2: Vector index management -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtVectorsTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Векторный индекс и эмбеддинги" />
                <TextBlock x:Name="TxtVectorsDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap"
                           Text="Векторные эмбеддинги формируются локальной моделью и обеспечивают поиск по смыслу запроса." />
                <WrapPanel Margin="0,0,0,6">
                  <Button x:Name="BtnClearFolderVectors" Content="Очистить векторы выбранной папки" Margin="0,0,8,6"
                          Click="OnClearFolderVectors" ToolTip="Очищает векторы только для папки, выделенной в списке выше" />
                  <Button x:Name="BtnClearAllVectors" Content="Очистить весь векторный индекс" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,6"
                          Click="OnClearAllVectors" ToolTip="Удаляет все векторы по всем папкам и ставит их в очередь на переиндексацию" />
                </WrapPanel>
                <TextBlock x:Name="TxtVectorsNote" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Используйте очистку выбранной папки для частичного обновления или полную очистку при смене модели эмбеддингов." />
              </StackPanel>
            </Border>

            <!-- Section: Embedding Model Selector -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtModelTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Модель векторных эмбеддингов (Нейросеть поиска)" />
                <TextBlock x:Name="TxtModelDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Gemma обрабатывает текст, изображения и аудио. BGE-M3 предназначена для многоязычного текста; текст на изображениях обрабатывается через OCR." />

                <TextBlock x:Name="TxtModelActiveLabel" Text="Активная модель эмбеддингов:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="ComboEmbeddingModel" DisplayMemberPath="Title" Margin="0,0,0,8" SelectionChanged="OnModelSelectionChanged" />

                <Border Background="{DynamicResource ModelBoxBackgroundBrush}" BorderBrush="{DynamicResource ModelBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                  <StackPanel>
                    <TextBlock x:Name="TxtModelStatusHeader" Text="🧠 Характеристики и статус модели:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource ModelBoxHeaderBrush}" />
                    <TextBlock x:Name="TxtModelStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                               Text="Загрузка каталога моделей…" />
                    <TextBlock x:Name="TxtModelDetails" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />

                    <!-- Download Button panel (visible when weights missing) -->
                    <StackPanel x:Name="PanelModelDownloadAction" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                      <Button x:Name="BtnDownloadModel" Content="📥 Скачать веса модели" Click="OnDownloadModelClick" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" FontSize="12" />
                      <TextBlock x:Name="TxtModelDownloadHint" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <!-- Download Progress panel (visible during download) -->
                    <StackPanel x:Name="PanelModelDownloadProgress" Margin="0,8,0,0" Visibility="Collapsed">
                      <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="TxtModelDownloadStatus" Text="Загрузка модели…" Foreground="{DynamicResource ModelBoxHeaderBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtModelDownloadPercent" Text="0%" Foreground="{DynamicResource TextAccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                      </DockPanel>
                      <ProgressBar x:Name="ProgressModelDownload" Height="6" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource InputBackgroundBrush}" Foreground="#00D2B4" BorderThickness="0" Margin="0,0,0,6" />
                      <DockPanel>
                        <TextBlock x:Name="TxtModelDownloadBytes" Text="0 / 0 МБ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <Button x:Name="BtnCancelModelDownload" Content="Отмена" Click="OnCancelModelDownloadClick" HorizontalAlignment="Right" Padding="8,3" FontSize="11" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="TxtModelNote" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Для каждой модели создаётся отдельный изолированный индекс. Предыдущие индексы сохраняются и не удаляются при переключении." />
              </StackPanel>
            </Border>

            <!-- Section: Hardware Acceleration (CPU / GPU) -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtHwTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Аппаратное ускорение (CPU / GPU для эмбеддингов)" />
                <TextBlock x:Name="TxtHwDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Выбор устройства для локальной генерации векторных эмбеддингов (поиск по смыслу). Поддерживаются дискретные и встроенные видеокарты всех производителей и процессорные вычисления." />

                <TextBlock x:Name="TxtHwDeviceLabel" Text="Вычислительное устройство:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="ComboHardware" DisplayMemberPath="Title" Margin="0,0,0,8" />

                <CheckBox x:Name="CheckQueryFastPathCpu" Margin="0,0,0,8" VerticalContentAlignment="Center">
                  <TextBlock x:Name="TxtCheckQueryFastPathCpu" Text="Мгновенный старт поиска на CPU (Query Fast-Path)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                </CheckBox>

                <Border Background="{DynamicResource HwBoxBackgroundBrush}" BorderBrush="{DynamicResource HwBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                  <StackPanel>
                    <TextBlock x:Name="TxtHwStatusHeader" Text="🖥 Обнаруженное оборудование:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource HwBoxHeaderBrush}" />
                    <TextBlock x:Name="TxtHardwareStatus" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                               Text="Определение оборудования…" />
                  </StackPanel>
                </Border>

                <TextBlock x:Name="TxtHwNote" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Поддерживаются дискретные NVIDIA (CUDA/Vulkan), AMD Radeon (Vulkan), Intel Arc (Vulkan), встроенные Intel Iris Xe/UHD и AMD Radeon APU. В случае сбоя GPU происходит безопасный откат на CPU." />
              </StackPanel>
            </Border>

            <!-- Section 3: Appearance and Translucency -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtAppearanceTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" Foreground="{DynamicResource TextPrimaryBrush}" Text="Внешний вид и прозрачность виджета поиска" />
                <TextBlock x:Name="TxtAppearanceDesc" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"
                           Text="Настройка полупрозрачности и темы для виджета поиска." />

                <DockPanel Margin="0,0,0,6">
                  <TextBlock x:Name="TxtOpacityLabel" Text="Прозрачность виджета поиска:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock x:Name="TxtOpacityValue" Text="100%" Foreground="{DynamicResource TextAccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
                <Slider x:Name="SliderOpacity" Minimum="50" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                        TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,10"
                        ValueChanged="OnOpacitySliderChanged" />
              </StackPanel>
            </Border>

            <!-- Section 5: Code search -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtCodeTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}" Text="Поиск по коду" />
                <CheckBox x:Name="Code" Content="Индексировать исходный код (запросы, начинающиеся с code:)" />
                <TextBlock x:Name="TxtCodeEditorLabel" Margin="0,6,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="Открывать код в редакторе:" />
                <ComboBox x:Name="Editor" Margin="0,0,0,4" />
              </StackPanel>
            </Border>

            <!-- Section 6: System & Updates -->
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock x:Name="TxtSystemTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}" Text="Система и обновления" />

                <CheckBox x:Name="Updates" Content="Проверять обновления программы раз в день" />
                <TextBlock x:Name="TxtUpdateSourceLabel" Text="Источник пакетов обновлений (GitHub Releases или папка):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4" />
                <TextBox x:Name="UpdateSource" Margin="0,0,0,6" ToolTip="По умолчанию: https://github.com/ex-ru/win_search. Оставьте репозиторий GitHub или укажите локальную папку." />
                <TextBlock x:Name="TxtSystemNote" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                           Text="WAI работает per-user: не требует прав администратора, данные хранятся в %LocalAppData%\WAI." />

                <!-- Diagnostic Logs -->
                <Border Background="{DynamicResource LogsBoxBackgroundBrush}" BorderBrush="{DynamicResource LogsBoxBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                  <DockPanel>
                    <Button x:Name="BtnOpenLogs" Content="📂 Открыть папку с логами" DockPanel.Dock="Left" Click="OnOpenLogs" Padding="12,6" Margin="0,0,12,0" />
                    <TextBlock x:Name="TxtLogsDesc" Foreground="{DynamicResource LogsBoxTextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Диагностические логи WAI, GPU/Vulkan и процесса индексации" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
